# DISHA Web Frontend Environment Configuration
# Copy this file to .env and replace placeholders with your actual credentials.

# Base URL of the DISHA API, without a trailing slash.
# Leave empty in local dev: Vite proxies /api to http://localhost:8000
# (override the proxy target with DISHA_API_PROXY_TARGET).
# Set it at build time for deployments. It is baked into the bundle and cannot
# be overridden at runtime (blueprint NFR-SEC-08).
VITE_API_BASE_URL=

# DISHA FastAPI Backend URL (fallback / direct target)
VITE_API_URL="http://localhost:8000"

# Google OAuth 2.0 Credentials
# Get your Client ID from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
VITE_GOOGLE_REDIRECT_URI="http://localhost:5173/auth/callback"

# Meko by YugabyteDB Universal Context Engine
# Get your endpoint and API key from https://mekodata.ai
VITE_MEKO_MCP_URL="https://your-datapack.mekodata.ai/mcp"
VITE_MEKO_API_KEY="your_meko_api_key_here"

# App Environment
VITE_APP_ENV="development"
