# Base URL of the DISHA API, without a trailing slash.
# Leave empty in local dev: Vite proxies /api to http://localhost:8000
# (override the proxy target with DISHA_API_PROXY_TARGET).
# Set it at build time for deployments. It is baked into the bundle and cannot
# be overridden at runtime (blueprint NFR-SEC-08).
VITE_API_BASE_URL=
