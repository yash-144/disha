# -----------------------------------------------------------------------------
# DISHA Environment Configuration Template
# -----------------------------------------------------------------------------
DISHA_ENV=development
DISHA_APP_NAME=DISHA
DISHA_LOG_LEVEL=INFO

# API Configuration
DISHA_API_PORT=8000
DISHA_API_HOST=0.0.0.0
DISHA_API_URL=http://localhost:8000
DISHA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Web Frontend Configuration
DISHA_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DISHA_API_URL=http://localhost:8000

# Database & Cache
DISHA_DATABASE_URL=postgresql+asyncpg://disha_user:disha_password@localhost:5432/disha_db
DISHA_REDIS_URL=redis://localhost:6379/0

# Security & Authentication (Replace in production)
DISHA_JWT_SECRET=replace_with_a_secure_random_secret_in_production
DISHA_JWT_ALGORITHM=HS256
DISHA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Background Worker
DISHA_WORKER_CONCURRENCY=4
DISHA_OUTBOX_BATCH_SIZE=50

# Blockchain Anchoring (Optional)
DISHA_BLOCKCHAIN_RPC_URL=http://localhost:8545
DISHA_DOCUMENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Meko agent memory (optional; leave MEKO_API_KEY empty to run without it, never commit a real key)
MEKO_API_KEY=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_DATAPACK=disha
MEKO_DATAPACK_ID=
MEKO_ENABLED=true
MEKO_PII_SALT=
MEKO_PROMOTE_MIN=3
MEKO_TIMEOUT=8
MEKO_CATALOG_PATH=
MEKO_TOOL_MAP=
MEKO_KB_MAX_BYTES=5242880

# Case outbox and escalation (worker)
DISHA_OUTBOX_MAX_ATTEMPTS=5            # failures before an item is dead-lettered
DISHA_OUTBOX_BASE_BACKOFF_SECONDS=5    # retry delay = base * 2^(attempt-1)
DISHA_ESCALATION_TARGET=role:hod       # destination_ref of escalation notifications

# Local IndicTrans2 translation (needs: pip install -e "api[translate]"). The ai4bharat models are gated on
# Hugging Face: accept their terms once, then set HF_TOKEN (or run huggingface-cli login) before first use.
DISHA_TRANSLATE_ENABLED=false
